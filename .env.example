# Server-side secret. Leave blank in this example and never commit a real key.
OPENAI_API_KEY=

# Optional OpenAI synthesis remains disabled by default.
USE_OPENAI_CHATBOT=false
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_REQUEST_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1
OPENAI_MAX_QUESTION_CHARS=750
OPENAI_MAX_EVIDENCE_ITEMS=6
OPENAI_MAX_CONTEXT_CHARS=12000
OPENAI_SESSION_REQUEST_QUOTA=20
OPENAI_REQUEST_COOLDOWN_SECONDS=3

# Optional, time-sensitive evaluation estimates. Leave blank to report unavailable.
OPENAI_INPUT_COST_PER_MILLION_TOKENS=
OPENAI_OUTPUT_COST_PER_MILLION_TOKENS=
