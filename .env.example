# Server-side secret. Leave blank in this example and never commit a real key.
OPENAI_API_KEY=

# Optional OpenAI mode remains disabled until hybrid synthesis is implemented.
USE_OPENAI_CHATBOT=false
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_REQUEST_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1
