# Byte-compiled Python and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python environments and packaging
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example
*.key

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# Streamlit local settings
.streamlit/secrets.toml

# Transient database sidecars must never become deployment artifacts
*.db-wal
*.db-shm
*.sqlite3-wal
*.sqlite3-shm

# Generated corpus and application artifacts
data/raw/*
data/processed/*
db/*.db
db/vector_index/*
outputs/*
!outputs/entities.csv
!outputs/relations.csv
!outputs/demo_answers.md
!outputs/demo_answers.json
!outputs/pre_openai_baseline.md
